# Vibe.Ai Configuration
# Copy this file to .env and modify as needed

# Server Configuration
PORT=3000
HOST=127.0.0.1

# API Authentication (optional)
# Leave empty for public mode (no authentication)
# Set a value to require API key authentication
VIBE_API_KEY=

# Rate Limiting
# Requests per minute per IP address
VIBE_RATE_LIMIT=60

# Rate limit window in milliseconds (default: 60000 = 1 minute)
VIBE_RATE_LIMIT_WINDOW=60000

# Maximum prompt character limit
# DuckAI has an upstream limit of ~16k characters
VIBE_MAX_PROMPT_CHARS=15000

# Request timeout in milliseconds (default: 180000 = 3 minutes)
VIBE_REQUEST_TIMEOUT=180000

# Maximum concurrent upstream requests
# Set to 1 to serialize requests (recommended for DuckAI)
VIBE_UPSTREAM_MAX_CONCURRENT=1

# Logging level (debug, info, warn, error)
VIBE_LOG_LEVEL=info

# CORS origin (default: * for all origins)
VIBE_CORS_ORIGIN=*

# Default AI provider (duckai, mistral, groq, openrouter)
VIBE_DEFAULT_PROVIDER=duckai

# ============================================
# AI Provider API Keys
# ============================================

# Mistral AI (https://mistral.ai)
# Get API key from: https://console.mistral.ai
MISTRAL_API_KEY=

# Groq (https://groq.com)
# Get API key from: https://console.groq.com
# Free tier: 1,000 requests/day, very fast inference
GROQ_API_KEY=

# OpenRouter (https://openrouter.ai)
# Get API key from: https://openrouter.ai/keys
# Free tier: 50 requests/day, access to 300+ models
OPENROUTER_API_KEY=

# OpenRouter Site Configuration (optional)
# For attribution, set these if you're using OpenRouter
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=
